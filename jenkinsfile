
pipeline {
    agent any

    stages {
        stage('Code Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vishuanjali/EasyCRUD.git'

                echo 'Code cloned successfully'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    cd backend
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd backend
                    mvn test
                '''
                echo 'Tests completed successfully'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube-Server') {
                    sh '''
                        cd backend
                       mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                  -Dsonar.projectKey=student-registration-backend \
                  -Dsonar.projectName=student-registration-backend
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Quality Gate passed. Ready to deploy.'
            }
        }

        stage('Monitor') {
            steps {
                echo 'Monitoring stage completed'
            }
        }
    }
}
