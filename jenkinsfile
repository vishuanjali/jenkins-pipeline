pipeline {
    agent any

    stages {
        stage('code clone') {
            steps {
               git branch: 'main', url: 'https://github.com/vishuanjali/EasyCRUD.git'
                echo 'code clone successfull'
            }
        }
        stage('build') {
            steps {
              sh '''
                  cd backend
                   mvn clean package -DskipTests
                       '''
            }
        }
        stage('test') {
            steps {
                echo 'code test successfull'
            }
        }
        stage('deploy') {
            steps {
                echo 'code deploy successfull'
            }
        }
 stage('monitor') {
            steps {
                echo 'code monitor successfull'
            }
        }
    }
}

