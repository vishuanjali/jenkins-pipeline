
pipeline {
    agent any

    stages {
        stage('Code Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vishuanjali/EasyCRUD.git'

                echo 'Code cloned successfully'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    cd backend
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd backend
                    mvn test
                '''
                echo 'Tests completed successfully'
            }
        }
        
 stage('sonar-scanner') {
            steps {
               withSonarQubeEnv(credentialsId: 'sonar-key') {
                       mvn sonar:sonar
                      }
                echo 'application code scan successfull'
            }
        }
        stage('Deploy') {
            steps {
                echo 'application deploy successfull'
            }
        }

        stage('Monitor') {
            steps {
                echo 'Monitoring stage completed'
            }
        }
    }
}
